<mjml>
	<mj-body background-color="#ffffff">
		<mj-raw>
			<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#ffffff">
				<tr>
					<td align="center" style="padding:40px 16px">
						<table width="560" cellpadding="0" cellspacing="0" role="presentation">
							<tr>
								<td style="padding:0 0 20px">
									<table cellpadding="0" cellspacing="0" role="presentation">
										<tr>
											<td style="vertical-align:middle;padding-right:10px">
												<img src="https://dashboard.stackblaze.cloud/email-logo.png" width="20" height="32" alt="" style="display:block;border:0" />
											</td>
											<td style="vertical-align:middle;font-family:Arial,Helvetica,sans-serif;font-size:20px;font-weight:700;color:#111111;letter-spacing:-0.02em">stackblaze</td>
										</tr>
									</table>
								</td>
							</tr>
							<tr>
								<td style="border-top:1px solid #eeeeee;font-size:0;line-height:0">&nbsp;</td>
							</tr>
							<tr>
								<td style="padding:36px 0 16px;font-family:Georgia,Times,serif;font-size:32px;line-height:1.25;font-weight:700;color:#111111">You've been unsubscribed</td>
							</tr>
							<tr>
								<td style="padding:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6;color:#555555">You will no longer get incident emails from <strong style="color:#111111">{{ companyName }}</strong>.</td>
							</tr>
							<tr>
								<td style="padding:0 0 28px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6;color:#555555">You can subscribe again any time from the status page.</td>
							</tr>
							<tr>
								<td align="center" style="padding:0 0 32px">
									<table cellpadding="0" cellspacing="0" role="presentation">
										<tr>
											<td bgcolor="#111111" style="border-radius:8px">
												<a href="{{ statusPageUrl }}" style="display:inline-block;padding:12px 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none">View status page</a>
											</td>
										</tr>
									</table>
								</td>
							</tr>
							<tr>
								<td style="padding:0 0 36px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6;color:#555555">The Stackblaze team</td>
							</tr>
							<tr>
								<td style="border-top:1px solid #eeeeee;font-size:0;line-height:0">&nbsp;</td>
							</tr>
							<tr>
								<td style="padding:20px 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.6;color:#888888"><a href="https://dashboard.stackblaze.cloud" style="color:#888888;text-decoration:none">Dashboard</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="https://docs.stackblaze.com" style="color:#888888;text-decoration:none">Docs</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="mailto:support@stackblaze.com" style="color:#888888;text-decoration:none">Support</a></td>
							</tr>
							<tr>
								<td style="padding:8px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#aaaaaa">© 2026 Stackblaze. All rights reserved.</td>
							</tr>
						</table>
					</td>
				</tr>
			</table>
		</mj-raw>
	</mj-body>
</mjml>
